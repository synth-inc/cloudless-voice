    "Cloudless uses Smart Cleanup to detect accidental filler words and remove them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless uses Smart Cleanup to detect accidental filler words and remove them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless utilise le Nettoyage intelligent pour détecter les mots de remplissage accidentels et les supprimer."
          }
        }
      }
    },
    "Cloudless uses Smart Cleanup to detect if you change your mind mid-dictation.\n\nSay things like: \"oh wait\", \"no sorry\", \"actually\", to trigger backtracking.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless uses Smart Cleanup to detect if you change your mind mid-dictation.\n\nSay things like: \"oh wait\", \"no sorry\", \"actually\", to trigger backtracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless utilise le Nettoyage intelligent pour détecter si vous changez d'avis en cours de dictée.\n\nDites par exemple : « oh attends », « non pardon », « en fait », pour déclencher le retour en arrière."
          }
        }
      }
    },
    "Cloudless uses Smart Cleanup to format and polish your dictations.\n\nJust say a trigger phrase and Cloudless handles the rest.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless uses Smart Cleanup to format and polish your dictations.\n\nJust say a trigger phrase and Cloudless handles the rest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless utilise le Nettoyage intelligent pour formater et peaufiner vos dictées.\n\nDites simplement une phrase déclencheur et Cloudless s'occupe du reste."
          }
        }
      }
    },
