    "Cloudless sends your instructions and your words, asks the model to put the result between <output> and </output>, and pastes only what's between them. Anything else the model says is ignored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless sends your instructions and your words, asks the model to put the result between <output> and </output>, and pastes only what's between them. Anything else the model says is ignored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudless envoie vos instructions et vos mots, demande au modèle de placer le résultat entre <output> et </output>, et ne colle que ce qui se trouve entre les deux. Tout le reste de la réponse est ignoré."
          }
        }
      }
    },
