    "An increasing number of people are looking for local, private alternatives to popular AI tools. AI dictation is no exception. Treat your audience to a genuinely great local app at half the price!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An increasing number of people are looking for local, private alternatives to popular AI tools. AI dictation is no exception. Treat your audience to a genuinely great local app at half the price!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De plus en plus de personnes cherchent des alternatives locales et privées aux outils d’IA populaires. La dictée par IA ne fait pas exception. Offrez à votre audience une application locale vraiment excellente, à moitié prix !"
          }
        }
      }
    },
