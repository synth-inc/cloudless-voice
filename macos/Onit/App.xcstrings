        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu générer votre code de parrainage unique."
          }
        }
      }
    },
    "We value your honest thoughts, but here is some inspiration if you need it:": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We value your honest thoughts, but here is some inspiration if you need it:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous valorisons vos avis honnêtes, mais voici un peu d'inspiration si vous en avez besoin :"
          }
        }
      }
    },
    "We'll let you know once it's ready!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll let you know once it's ready!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous préviendrons dès que ce sera prêt !"
          }
        }
      }
    },
    "We'll promote your content in our app, and we have a referral leaderboard that tracks downloads through your invite link. Climb the list and every new user who opens Cloudless will see your channel. That's ongoing visibility long after your video goes up!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll promote your content in our app, and we have a referral leaderboard that tracks downloads through your invite link. Climb the list and every new user who opens Cloudless will see your channel. That's ongoing visibility long after your video goes up!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ferons la promotion de votre contenu dans notre application, et nous avons un classement de parrainage qui suit les téléchargements via votre lien d’invitation. Grimpez dans le classement et chaque nouvel utilisateur qui ouvre Cloudless verra votre chaîne. C’est une visibilité continue bien après la mise en ligne de votre vidéo !"
          }
        }
      }
    },
    "Were you referred by someone?": {
      "extractionState": "manual",
