            "value": "Typical range is -0.20 to 0.0; default is -0.126. Lower values accept more replacements; higher values are stricter. Clear to use the default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plage typique : -0,20 à 0,0 ; valeur par défaut : -0,126. Des valeurs plus basses acceptent plus de remplacements ; des valeurs plus élevées sont plus strictes. Effacez pour utiliser la valeur par défaut."
          }
        }
      }
    },
