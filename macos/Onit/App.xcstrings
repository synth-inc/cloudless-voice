    "We auto-generate a common word with similar meaning to help Cloudless understand your term. You can replace this with a better word. Removing it completely will turn off this feature and likely reduce accuracy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We auto-generate a common word with similar meaning to help Cloudless understand your term. You can replace this with a better word. Removing it completely will turn off this feature and likely reduce accuracy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous générons automatiquement un mot courant ayant un sens similaire pour aider Cloudless à comprendre votre terme. Vous pouvez le remplacer par un mot plus adapté. Le supprimer complètement désactivera cette fonctionnalité et réduira probablement la précision."
          }
        }
      }
    },
    "We couldn't generate your unique referral code.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
